# ignore all folders except the ones specified inside the ormi-core/plugins folder
# keep
#
#   - ormi-app/plugins/standard-widgets
#   - ormi-app/plugins/ros-2
#   - ormi-app/plugins/random-data-sources
#
# Ignore all other folders inside ormi-app/plugins

ormi-app/plugins/*
!ormi-app/plugins/standard-widgets
!ormi-app/plugins/ros-2
!ormi-app/plugins/random-data-sources
ormi-core/dist
ormi-standart-widgets/dist
ormi-app/ormi-plugins.ts


# Ignore the postgres folder and files
postgres/*
apps/web/.env


.turbo
**/.turbo
**/.next
apps/web/ormi-plugins.ts

