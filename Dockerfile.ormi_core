# Use the official Bun image
FROM oven/bun:latest

# Set working directory
WORKDIR /ormi-core

# Copy package.json and bun.lockb (if exists)
COPY ./ormi-core/package.json ./
COPY ./ormi-core/bun.lockb ./

# Install dependencies
RUN bun install

# Copy the rest of the application
COPY ./ormi-core .

# Link the ormi plugins
RUN bun link

# Initialize the ormi plugins
RUN ormi-plugins init

# build the application
RUN bun run build

# Start the server
CMD ["bun", "run", "start"]