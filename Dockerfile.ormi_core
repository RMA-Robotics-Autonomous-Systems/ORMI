# Use the official Bun image
FROM oven/bun:debian

# Install necessary system dependencies for crypto and native modules
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3 \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /ORMI-CORE

# Copy all folders from the host to the container
COPY . .

# Copy the entrypoint script
COPY ormi_entrypoint.sh /entrypoint.sh

# Make scripts executable and run the build script (installs deps, links packages)
RUN chmod +x /entrypoint.sh \
    && chmod +x build.sh \
    && ./build.sh

# Set the working directory for the application runtime
WORKDIR /ORMI-CORE/ormi-app

# Set the entrypoint
ENTRYPOINT ["/entrypoint.sh"]

# Expose the port Next.js runs on (usually 3000)
EXPOSE 3000