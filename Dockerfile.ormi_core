# Use latest Node.js LTS version
FROM node:lts-bullseye

# Set the timezone to UTC
ENV TZ=UTC
# Set the locale to UTF-8
ENV LANG=C.UTF-8

# Install Bun
RUN curl -fsSL https://bun.sh/install | bash && \
	mv /root/.bun/bin/bun /usr/local/bin/bun && \
	rm -rf /root/.bun
# Set working directory
WORKDIR /ORMI-CORE
# Copy all folders from the host to the container
COPY . .

RUN bun install

# NEXT_PUBLIC_APP_URL is inlined into the client bundle by Next.js at build time
ARG NEXT_PUBLIC_APP_URL=http://localhost:3000
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
# Skip runtime env validation during build; server vars are injected at container start
ENV SKIP_ENV_VALIDATION=1
RUN bun run build
# Remove the build-time skip flag so runtime validation runs normally
ENV SKIP_ENV_VALIDATION=

CMD ["bun", "run", "start"]
