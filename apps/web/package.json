{
	"name": "web",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "bun ../../packages/utils/dist/cli/index.js init ormi-plugins.ts && bun --bun next dev",
		"build": "bun ../../packages/utils/dist/cli/index.js init ormi-plugins.ts && bun run db-generate && bun --bun next build",
		"start": "bun run db-deploy && bun --bun next start",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"typecheck": "bun run plugin-init && bun run db-generate && tsc --noEmit",
		"plugin-init": "bun ../../packages/utils/dist/cli/index.js init ormi-plugins.ts",
		"db-generate": "prisma generate",
		"db-migrate": "prisma migrate dev --name init",
		"db-studio": "prisma studio",
		"db-reset": "prisma migrate reset --force",
		"db-deploy": "dotenv -- prisma migrate deploy",
		"clean": "rm -rf .next dist build .turbo node_modules"
	},
	"dependencies": {
		"@auth/prisma-adapter": "^2.11.1",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@hookform/resolvers": "^5.2.2",
		"@prisma/adapter-pg": "^7.3.0",
		"@prisma/client": "^7.3.0",
		"@radix-ui/react-avatar": "^1.1.11",
		"@t3-oss/env-nextjs": "^0.13.10",
		"@types/pg": "^8.16.0",
		"@workspace/ormi-core": "workspace:*",
		"@workspace/ormi-plugins": "workspace:*",
		"@workspace/ui": "workspace:*",
		"@workspace/utils": "workspace:*",
		"highlight.js": "^11.11.1",
		"lucide-react": "^0.563.0",
		"mermaid": "^11.12.2",
		"moment": "^2.30.1",
		"next": "^16.1.6",
		"next-auth": "^4.24.13",
		"next-themes": "^0.4.6",
		"ormi-flight-indicator": "workspace:*",
		"ormi-foxglove": "workspace:*",
		"ormi-emi-bag-analyzer": "workspace:*",
		"ormi-loadgen": "workspace:*",
		"ormi-randoms-datasources": "workspace:*",
		"ormi-rest-bags": "workspace:*",
		"ormi-rosbridge-suite": "workspace:*",
		"ormi-std-widgets": "workspace:*",
		"ormi-tello": "workspace:*",
		"ormi-rostainer": "workspace:*",
		"pg": "^8.18.0",
		"prisma": "^7.3.0",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-hook-form": "^7.71.1",
		"sonner": "^2.0.7",
		"teodor-emi-extension": "workspace:*",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.1.18",
		"@types/bun": "^1.3.8",
		"@types/node": "^25.2.1",
		"@types/react": "^19.2.13",
		"@types/react-dom": "^19.2.3",
		"@workspace/eslint-config": "workspace:^",
		"@workspace/typescript-config": "workspace:*",
		"dotenv-cli": "^11.0.0",
		"typescript": "^5.9.3"
	}
}
