{
    "name": "web",
    "version": "0.0.1",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "bun ../../packages/utils/dist/cli/index.js init ormi-plugins.ts && next dev --turbopack",
        "build": "bun ../../packages/utils/dist/cli/index.js init ormi-plugins.ts && bun run db-generate && next build",
        "start": "bun run db-migrate && next start",
        "lint": "next lint",
        "lint:fix": "next lint --fix",
        "typecheck": "tsc --noEmit",
        "db-generate": "prisma generate",
        "db-migrate": "prisma migrate dev --name init",
        "db-studio": "prisma studio",
        "db-reset": "prisma migrate reset --force"
    },
    "dependencies": {
        "@auth/prisma-adapter": "^2.8.0",
        "@prisma/client": "^6.5.0",
        "@t3-oss/env-nextjs": "^0.12.0",
        "@workspace/ormi-core": "workspace:*",
        "@workspace/ormi-plugins": "workspace:*",
        "@workspace/ui": "workspace:*",
        "@workspace/utils": "workspace:*",
        "gray-matter": "^4.0.3",
        "highlight.js": "^11.11.1",
        "lucide-react": "^0.475.0",
        "moment": "^2.30.1",
        "next": "^15.2.3",
        "next-auth": "^4.24.11",
        "next-mdx-remote": "^5.0.0",
        "next-themes": "^0.4.4",
        "ormi-flight-indicator": "workspace:*",
        "ormi-foxglove": "workspace:*",
        "ormi-randoms-datasources": "workspace:*",
        "ormi-rest-bags": "workspace:*",
        "ormi-ros2-type-extension": "workspace:*",
        "ormi-rosbridge-suite": "workspace:*",
        "ormi-std-widgets": "workspace:*",
        "ormi-tello": "workspace:*",
        "prisma": "^6.5.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "rehype-autolink-headings": "^7.1.0",
        "rehype-highlight": "^7.0.1",
        "rehype-slug": "^6.0.0",
        "remark-gfm": "^4.0.0",
        "teodor-emi-extension": "workspace:*"
    },
    "devDependencies": {
        "@tailwindcss/typography": "^0.5.19",
        "@types/bun": "^1.2.17",
        "@types/mdx": "^2.0.13",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@workspace/eslint-config": "workspace:^",
        "@workspace/typescript-config": "workspace:*",
        "typescript": "^5.7.3"
    }
}
