{
  "name": "ormi-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run clean && ormi-plugins init ormi-plugins.ts && next dev --turbopack",
    "build": "bun run clean && ormi-plugins init ormi-plugins.ts && prisma generate && bun run db-migrate-deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "rm -rf .next && rm -rf node_modules && bun i",
    "db-generate": "prisma generate",
    "db-migrate-dev": "dotenv -e .env.development -- prisma migrate dev",
    "db-migrate-deploy": "dotenv -e .env.production -- prisma migrate deploy",
    "db-push": "dotenv -e .env.development -- prisma db push",
    "db-studio": "dotenv -e .env.development -- prisma studio"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.8.0",
    "@hookform/resolvers": "^4.1.3",
    "@prisma/client": "^6.5.0",
    "@radix-ui/react-accordion": "^1.2.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-icons": "^1.3.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@total-typescript/ts-reset": "^0.5.1",
    "@types/react-grid-layout": "^1.3.5",
    "@vercel/og": "^0.6.8",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250328",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dotenv-cli": "^8.0.0",
    "lucide-react": "^0.517.0",
    "next": "15.3.4",
    "next-auth": "^4.24.11",
    "next-themes": "^0.4.6",
    "nodemailer": "^6.10.0",
    "ormi-components": "link:ormi-components",
    "ormi-core": "link:ormi-core",
    "ormi-fligth-indicator": "link:ormi-fligth-indicator",
    "ormi-random": "link:ormi-random",
    "ormi-ros-2": "link:ormi-ros-2",
    "ormi-ros-2-foxglove": "link:ormi-ros-2-foxglove",
    "ormi-standart-widgets": "link:ormi-standart-widgets",
    "ormi-tello": "link:ormi-tello",
    "prisma": "^6.5.0",
    "react": "19.1.0",
    "react-compiler-runtime": "^19.1.0-rc.2",
    "react-dom": "19.1.0",
    "react-grid-layout": "^1.5.1",
    "react-hook-form": "^7.55.0",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.0.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  }
}
