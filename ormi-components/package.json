{
  "name": "ormi-components",
  "module": "./dist/src/index.js",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    }
  },
  "scripts": {
    "build-lib": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json && copyfiles -u 1 'src/**/*.css' dist",
    "clean": "rm -rf dist && rm -rf node_modules && rm -rf bun.lockb",
    "build": "bun run clean && bun i && bun run build-lib && bun link"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
