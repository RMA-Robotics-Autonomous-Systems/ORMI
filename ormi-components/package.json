{
  "name": "ormi-components",
  "module": "./dist/intex.js",
  "main": "./dist/intex.js",
  "types": "./dist/intex.d.ts",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/intex.js",
      "types": "./dist/intex.d.ts"
