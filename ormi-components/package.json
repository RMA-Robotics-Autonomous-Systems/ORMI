  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5",
    "react": "^18.0.0",
    "@types/react": "^19.1.8"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.522.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.4"
  }
