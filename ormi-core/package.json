{
  "name": "ormi-core",
  "version": "0.1.0",
  "private": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && copyfiles -u 1 'src/library/**/*.css' dist"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "next": ">=15.2.1"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@tailwindcss/postcss": "^4",
    "tailwindcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "15.2.1",
    "@eslint/eslintrc": "^3"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/exports.js",
      "require": "./dist/exports.js"
    },
    "./templates": {
      "import": "./dist/templates.js",
      "require": "./dist/templates.js"
    },
    "./plugins": {
      "import": "./dist/plugins.js",
      "require": "./dist/plugins.js"
    },
    "./dashboard": {
      "import": "./dist/dashboard.js",
      "require": "./dist/dashboard.js"
    },
    "./datasources": {
      "import": "./dist/datasources.js",
      "require": "./dist/datasources.js"
    },
    "./widgets": {
      "import": "./dist/widgets.js",
      "require": "./dist/widgets.js"
    },
    "./utils": {
      "import": "./dist/utils.js",
      "require": "./dist/utils.js"
    },
    "./types": {
      "import": "./dist/types.js",
      "require": "./dist/types.js"
    },
    "./jsonforms": {
      "import": "./dist/jsonforms.js",
      "require": "./dist/jsonforms.js"
    },
    "./components": {
      "import": "./dist/components.js",
      "require": "./dist/components.js"
    }
  },
  "main": "dist/exports.js",
  "dependencies": {
    "@jsonforms/core": "^3.5.1",
    "@jsonforms/material-renderers": "^3.5.1",
    "@jsonforms/react": "^3.5.1",
