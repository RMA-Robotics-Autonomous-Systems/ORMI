{
  "name": "ormi-core",
  "version": "0.1.0",
  "private": false,
  "scripts": {
    "build": "bun run clean && bun run build:types && bun run build:lib && bun run build:cli",
    "build:cli": "bun build ./src/library/core/cli/index.ts --outdir ./dist/cli --target node",
    "build:lib": "bun build ./src/*.ts --outdir ./dist",
    "build:types": "tsc && tsc-alias",
    "clean": "rm -rf dist"
  },
  "bin": {
    "ormi-plugins": "./dist/cli/index.js"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "next": ">=15.2.1",
    "@types/react": ">=18.0.0",
    "@types/react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/bun": "^1.2.17",
    "@types/node": "^20",
    "typescript": "^5.3.3",
    "tsc-alias": "^1.8.10"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/src/exports.js",
      "require": "./dist/src/exports.js",
      "types": "./dist/types/exports.d.ts"
    },
    "./templates": {
      "import": "./dist/src/templates.js",
      "require": "./dist/src/templates.js",
      "types": "./dist/types/templates.d.ts"
    },
    "./plugins": {
      "import": "./dist/src/plugins.js",
      "require": "./dist/src/plugins.js",
      "types": "./dist/types/plugins.d.ts"
    },
    "./dashboard": {
      "import": "./dist/src/dashboard.js",
      "require": "./dist/src/dashboard.js",
      "types": "./dist/types/dashboard.d.ts"
    },
    "./datasources": {
      "import": "./dist/src/datasources.js",
      "require": "./dist/src/datasources.js",
      "types": "./dist/types/datasources.d.ts"
    },
    "./widgets": {
      "import": "./dist/src/widgets.js",
      "require": "./dist/src/widgets.js",
      "types": "./dist/types/widgets.d.ts"
    },
    "./utils": {
      "import": "./dist/src/utils.js",
      "require": "./dist/src/utils.js",
      "types": "./dist/types/utils.d.ts"
    },
    "./transforms": {
      "import": "./dist/src/transforms.js",
      "require": "./dist/src/transforms.js",
      "types": "./dist/types/transforms.d.ts"
    },
    "./types": {
      "import": "./dist/src/types.js",
      "require": "./dist/src/types.js",
      "types": "./dist/types/types.d.ts"
    },
    "./jsonforms": {
      "import": "./dist/src/jsonforms.js",
      "require": "./dist/src/jsonforms.js",
      "types": "./dist/types/jsonforms.d.ts"
    },
    "./components": {
      "import": "./dist/src/components.js",
      "require": "./dist/src/components.js",
      "types": "./dist/types/components.d.ts"
    }
  },
  "main": "dist/exports.js",
  "types": "dist/types/src/exports.d.ts",
  "dependencies": {
    "@jsonforms/core": "^3.5.1",
    "@jsonforms/material-renderers": "^3.5.1",
    "@jsonforms/react": "^3.5.1",
    "@mui/material": "7.0.0",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-hover-card": "^1.1.6",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@types/lodash": "^4.17.16",
    "@types/react-grid-layout": "^1.3.5",
    "chalk": "^5.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "commander": "^13.1.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "lodash": "^4.17.21",
    "lucide-react": "^0.479.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^9.5.1",
    "react-grid-layout": "^1.5.1",
    "react-resizable": "^3.0.5",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.0.2"
  }
}
