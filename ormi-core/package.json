    "@types/react-grid-layout": "^1.3.5",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.0.4",
    "commander": "^13.1.0",
    "date-fns": "^4.1.0",
    "inquirer": "^12.4.2",
    "install": "^0.13.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.479.0",
    "next-themes": "^0.4.4",
    "ora": "^8.2.0",
    "react-day-picker": "^9.5.1",
    "react-grid-layout": "^1.5.0",
