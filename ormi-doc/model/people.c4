// Actors and external systems ORMI talks to.
// The datasource landscape: ROS2/rosbridge, Foxglove, Tello, REST — most robots
// expose plain ws:// endpoints (see the main-thread routing note in datasources.c4).

model {
  operator = actor 'Operator' {
    description 'Robotics operator monitoring and controlling autonomous systems through the ORMI dashboard.'
  }

  robot = externalSystem 'Robot / Autonomous System' {
    description 'Heterogeneous robot or autonomous vehicle. Exposes its data through a ROS2, Foxglove, or vendor bridge — commonly over plain ws://.'
  }

  rosbridge = externalSystem 'ROS2 / rosbridge' {
    description 'rosbridge_suite WebSocket server bridging ROS2 topics, services, and TF onto a JSON/CBOR wire protocol.'
  }

  foxglove = externalSystem 'Foxglove WebSocket' {
    description 'Foxglove WebSocket protocol server streaming robot telemetry (PointCloud2, LaserScan, TF, diagnostics, …) as CDR-encoded messages.'
  }

  tello = externalSystem 'DJI Tello' {
    description 'DJI Tello drone exposing a UDP/WebSocket bridge on ws://<ip>:8005 for telemetry and flight commands.'
  }

  restEndpoint = externalSystem 'REST / Bag Endpoint' {
    description 'Remote rosbag service behind the REST Bags datasource: list, delete, download and compress bags, record, and play back. Reached browser-direct through RestBagClient.'
  }

  c2MissionControl = externalSystem 'C2 Mission Control REST' {
    description 'The C2 command service (C++ REST, missionControlUrl, :5001 by default). Reached browser-direct by the C2 datasource remote calls; every request carries the auth token (missionControlToken, as Authorization: Bearer and X-C2-Token) when one is configured.'
  }

  c2MongoRest = externalSystem 'C2 Mongo REST' {
    description 'The C2 mission database service (Mongo REST, dbUrl, :5000 by default). Reached browser-direct by the C2 datasource remote calls; the token rides on mutating requests only, GETs stay bare.'
  }

  webrtcOffer = externalSystem 'WebRTC Offer Endpoint' {
    description 'Robot-side WebRTC video server. The rosbridge WebRTC widget POSTs its SDP offer to http://<host>:8080/offer straight from the browser.'
  }

  rostainer = externalSystem 'ROS Container Host' {
    description 'Docker container manager beside the robot ROS graph. Publishes container status as a DiagnosticArray topic and exposes <ns>/docker/restart and <ns>/docker/pull, which the ROSTainer widget reaches only through a ROS datasource remote calls, never directly.'
  }

  basemapProviders = externalSystem 'Basemap Tile Providers' {
    description 'The six hosted map vendors behind the shared basemap catalogue (packages/utils/src/basemap-providers.ts): Carto, OpenStreetMap (incl. HOT and OpenTopoMap), Stadia Maps, Esri ArcGIS, BKG TopPlus, and OpenFreeMap. Ten catalogue rows are raster XYZ tiles; OpenFreeMap additionally serves the vector tiles, glyphs and sprites behind the three MapLibre styles ORMI bundles. Carto and Stadia require an operator-supplied API key; the default basemap is OpenFreeMap Liberty (vector, DEFAULT_BASEMAP_URL); OpenFreeMap states no SLA.'
  }

  tileServers = externalSystem 'Map / Tile Servers' {
    description 'Raster map servers an operator registers in their map-server registry: GeoServer (GWC WMTS or WMS), TiTiler (COG), any OGC WMS, any XYZ template, plus the public overlay hosts of the xyz preset. Reached by the OPERATOR BROWSER directly, for discovery and tiles; never proxied by the ORMI server. Must answer CORS from the ORMI origin, and name Authorization in Access-Control-Allow-Headers when header or basic auth is used.'
  }
}
