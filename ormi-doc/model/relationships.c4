// Cross-cutting wiring between web components, plugins, datasource runtime, and
// external systems. Element-local relationships stay with their elements; the
// data-flow spanning many elements is collected here.

model {

  // ---- Operator ------------------------------------------------------------

  operator -> ormi.web.dashboard 'monitors & controls via'

  // ---- External bridges ----------------------------------------------------

  rosbridge -> robot 'bridges ROS2 topics/services/TF'
  foxglove -> robot 'streams telemetry from'

  // ---- Datasource plugins → external systems -------------------------------

  ormi.web.plugins.foxglovePlugin -> foxglove 'connects (wss:// worker · ws:// main thread)'
  ormi.web.plugins.rosbridgePlugin -> rosbridge 'subscribes / calls services'
  ormi.web.plugins.telloPlugin -> tello 'telemetry & flight commands (ws://)'
  ormi.web.plugins.restBagsPlugin -> restEndpoint 'manages bags: list, download, compress, record, play back (browser-direct)'
  ormi.web.plugins.rostainerPlugin -> ormi.web.remoteCalls 'restart / pull through the bound status topic datasource remote calls'
  rostainer -> robot 'answers the <ns>/docker/restart and <ns>/docker/pull actions on the robot ROS graph'
  ormi.web.plugins.c2Control -> c2MissionControl 'mission commands (browser-direct REST, auth token on every request)'
  ormi.web.plugins.c2Control -> c2MongoRest 'mission CRUD (browser-direct REST, auth token on mutations)'
  ormi.web.plugins.rosbridgePlugin -> webrtcOffer 'WebRTC widget POSTs its SDP offer (browser-direct, http://<host>:8080/offer)'

  // ---- Map widgets -> basemap providers ------------------------------------
  // Tiles, styles, glyphs and sprites are fetched by the OPERATOR BROWSER
  // straight from the vendor CDN. Nothing is proxied by the Next.js server and
  // nothing is self-hosted, so a vendor outage degrades only the dashboards
  // that selected that basemap.

  ormi.web.plugins.stdWidgets -> basemapProviders 'fetches basemap tiles + bundled vector style sources (browser -> vendor CDN)'
  ormi.web.plugins.c2Control -> basemapProviders 'fetches basemap tiles (browser -> vendor CDN)'
  ormi.web.plugins.emiBagAnalyzer -> basemapProviders 'fetches OpenStreetMap raster tiles itself (gps-map-advanced)'
  ormi.web.plugins.teodorEmi -> basemapProviders 'seeds Carto Voyager on its cockpit map'

  // ---- Map layers: the user map-server registry ----------------------------
  // Discovery and tiles are browser-direct. The ORMI server stores records and
  // catalogue snapshots and never fetches a registered URL.

  ormi.web.plugins.mapServersPlugin -> ormi.web.pluginsManager 'registers adapters (MAP_LAYER_PROVIDERS)'
  ormi.web.mapLayers -> ormi.web.pluginsManager 'reads MAP_LAYER_PROVIDERS (usePluginFiltersRevision)'
  ormi.web.mapServerSettings -> ormi.web.pluginsManager 'reads MAP_LAYER_PROVIDERS (types, forms, presets)'
  ormi.web.mapServerSettings -> tileServers 'adapter.discover() capabilities (browser-direct, auth via ctx.fetch)'
  ormi.web.mapServerSettings -> ormi.web.httpClient 'create / update / remove / putCatalog (mapServerApi)'
  ormi.web.mapServerSettings -> ormi.web.mapLayers 'settles mapServersAtom after an edit'
  ormi.web.mapLayers -> ormi.web.httpClient 'load the registry (GET /api/map-servers)'
  ormi.web.mapLayers -> ormi.web.appStore 'mapServersAtom, mapLayerHealthAtom'
  ormi.web.renderers -> ormi.web.mapLayers 'mapLayersSelect control reads mapServersAtom at render'
  ormi.web.plugins.stdWidgets -> ormi.web.mapLayers 'useMapRasterLayers, RasterOverlayLayers, MapLayersOverlay'
  ormi.web.plugins.c2Control -> ormi.web.mapLayers 'useMapRasterLayers, RasterOverlayLayers, MapLayersOverlay'
  ormi.web.plugins.emiBagAnalyzer -> ormi.web.mapLayers 'useMapRasterLayers, RasterOverlayLayers, MapLayersOverlay, handleMapError'
  ormi.web.mapLayers -> tileServers 'raster tiles (browser-direct, query auth or scoped headers)'
  ormi.web.httpClient -> ormi.web.mapServersApi 'HTTP /api/map-servers (ApiResult<T>)'
  ormi.web.mapServersApi -> ormi.web.auth 'withAuth guard'
  ormi.web.mapServersApi -> ormi.db 'MapServer rows via prisma-map-servers (where: { id, userId })'

  // ---- Plugin registration -------------------------------------------------

  ormi.web.pluginLoader -> ormi.web.plugins 'imports & instantiates'
  ormi.web.plugins -> ormi.web.pluginsManager 'registers filters/actions (WIDGETS_LIST, DATASOURCES_LIST, JSON_FORMS_RENDERER, PAGES_LIST, …)'

  // ---- Datasource plugins plug into the shared runtime ---------------------

  ormi.web.plugins.foxglovePlugin -> ormi.web.datasourceRuntime 'runs its worker / main-thread connection in'
  ormi.web.plugins.rosbridgePlugin -> ormi.web.datasourceRuntime.mainThreadConn 'runs roslib on the main thread (ws:// and wss://), through the shared coalescer'
  ormi.web.plugins.telloPlugin -> ormi.web.datasourceRuntime.mainThreadConn 'runs on (insecure ws://), onmessage straight to doAction (no coalescer)'
  ormi.web.plugins.loadgenPlugin -> ormi.web.datasourceRuntime 'drives synthetic load through its worker / main-thread coalescer path'

  // ---- Ingest data flow (datasource → PluginsManager) ----------------------

  ormi.web.datasourceRuntime.dsWorker -> ormi.web.datasourceRuntime.coalescer 'opt-in worker-side coalesce-to-latest before decode (foxglove wss://, createCoalescedPublisher)'
  ormi.web.datasourceRuntime.dsWorker -> ormi.web.datasourceRuntime.converter 'normalize raw → webapp type (at drain rate when coalesced)'
  ormi.web.datasourceRuntime.dsWorker -> ormi.web.datasourceRuntime.workerHost 'ctx.publish / server.emit (typed RPC, zero-copy transferables via transferablesFor)'
  ormi.web.datasourceRuntime.workerHost -> ormi.web.pluginsManager 'publishes normalized data'
  ormi.web.datasourceRuntime.mainThreadConn -> ormi.web.datasourceRuntime.coalescer 'raw ws:// messages'
  ormi.web.datasourceRuntime.coalescer -> ormi.web.datasourceRuntime.converter 'coalesced-to-latest, decode-budgeted'
  ormi.web.datasourceRuntime.mainThreadConn -> ormi.web.pluginsManager 'publishes normalized data (budgeted)'

  // ---- Subscription lifecycle ---------------------------------------------

  ormi.web.datasourceRuntime.localData -> ormi.web.datasourceRuntime.subscriptionRegistry 'declares refcounted subscribe intents'
  ormi.web.datasourceRuntime.subscriptionRegistry -> ormi.web.pluginsManager 'issues -subscribe/-advertise on DATASOURCE_READY'
  ormi.web.pluginsManager -> ormi.web.datasourceRuntime.workerHost 'subscribe / unsubscribe / shutdown'
  ormi.web.pluginsManager -> ormi.web.datasourceRuntime.mainThreadConn 'subscribe / unsubscribe'

  // ---- Consumer data flow (PluginsManager → widget) ------------------------

  ormi.web.pluginsManager -> ormi.web.datasourceRuntime.subscriptionRegistry 'published action, one per wire key'
  ormi.web.datasourceRuntime.subscriptionRegistry -> ormi.web.datasourceRuntime.localData 'fans out to each intent callback'
  ormi.web.datasourceRuntime.localData -> ormi.web.widgetHost 'buffered data via useLocalDataSource (30Hz) + health'
  ormi.web.dashboard -> ormi.web.widgetHost 'mounts placed widgets (per-widget error boundary)'

  // ---- Transform (TF) flow -------------------------------------------------

  ormi.web.datasourceRuntime.converter -> ormi.web.transforms 'processTFMessage(datasourceId, msg, { isStatic })'
  ormi.web.transforms -> ormi.web.appStore 'version bump + sources (transformVersionAtom, transformSourcesAtom); the edges stay in a module Map'
  ormi.web.transforms -> ormi.web.widgetHost 'frame data via useTransformEdges / useWorldFrames / useTransformToGPS'

  // ---- Remote calls --------------------------------------------------------

  ormi.web.pluginsManager -> ormi.web.remoteCalls 'aggregates AVAILABLE_REMOTE_CALLS'
  ormi.web.remoteCalls -> ormi.web.appStore 'setRemoteCalls'
  ormi.web.widgetHost -> ormi.web.remoteCalls 'invokes via useRemoteCall'

  // ---- Dashboard state & config -------------------------------------------

  ormi.web.dashboard -> ormi.web.appStore 'reads/writes widgets, layouts, locked, datasources'
  ormi.web.dashboard -> ormi.web.renderers 'renders widget/datasource config forms'
  ormi.web.renderers -> ormi.web.pluginsManager 'AVAILABLE_TOPICS (pull filter): topic picker list + auto-bind of a sole direct type match'
  ormi.web.transforms -> ormi.web.renderers 'frame list for FrameSelect (auto-binds once the tree settles)'
  ormi.web.renderers -> ormi.web.appStore 'configured datasources (datasourcesAtom) for the datasource picker, read at render'
  ormi.web.dashboard -> ormi.web.ui 'uses primitives'
  ormi.web.widgetHost -> ormi.web.ui 'uses primitives (DatasourceGate offline card)'
  ormi.web.dashboard -> ormi.web.templates 'save/apply widget & datasource templates'
  ormi.web.ui -> ormi.web.datasourceRuntime.globalDatasources 'DATASOURCE_CONFIGURE_EVENT (offline card → its own Datasources dialog)'
  ormi.web.datasourceRuntime.globalDatasources -> ormi.web.pluginsManager 'registers AVAILABLE_DATASOURCES + the WIDGETS_LIST datasource gate'
  ormi.web.datasourceRuntime.globalDatasources -> ormi.web.appStore 'reads datasourcesAtom, mounts each datasource Provider'

  // ---- Client → server -----------------------------------------------------

  ormi.web.dashboard -> ormi.web.httpClient 'load/save workspaces (a dashboard is Workspace.content, /api/workspaces)'
  ormi.web.templates -> ormi.web.httpClient 'persist via /api/templates'
  ormi.web.datasourceRuntime.knownDatasources -> ormi.web.httpClient 'read known configurations (GET /api/datasources/known, on dialog open)'
  ormi.web.datasourceRuntime.knownDatasources -> ormi.web.dashboard 'offers a saved configuration to the add-datasource picker; adding seeds a new instance'
  ormi.web.httpClient -> ormi.web.apiRoutes 'HTTP (ApiResult<T>)'
  ormi.web.apiRoutes -> ormi.web.auth 'withAuth guard'
  ormi.web.apiRoutes -> ormi.web.serverData 'DB access via Prisma helpers'
  ormi.web.serverData -> ormi.db 'Prisma queries'
  ormi.web.auth -> ormi.db 'sessions & accounts'
}
