{
  "name": "ormi-ros-2",
  "description": "Ros 2 plugin for ormi app, it allow to connect to ros 2 topics and services",
  "author": {
    "name": "Florian Lebecque",
    "email": "florian.lebecque@mil.be"
  },
  "version": "0.1.0",
  "private": false,
  "scripts": {
    "build-lib": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && copyfiles -u 1 'src/library/**/*.css' dist",
    "clean": "rm -rf dist && rm -rf node_modules && rm -rf bun.lockb",
    "build": "bun run clean && bun i && bun run build-lib && bun link"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "next": "^15.2.4",
    "ormi-core": "link:ormi-core"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/react": "^18.3.20",
    "@eslint/eslintrc": "^3",
    "@types/roslib": "^1.3.5"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "dependencies": {
    "@jsonforms/core": "^3.5.1",
    "@types/d3": "^7.4.3",
    "@types/js-yaml": "^4.0.9",
    "copyfiles": "^2.4.1",
    "d3": "^7.9.0",
    "force-graph": "^1.49.2",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.479.0",
    "next-themes": "^0.4.4",
    "roslib": "^1.4.1",
    "tsc-alias": "1.8.11"
  },
  "ormi_plugin": true
}
