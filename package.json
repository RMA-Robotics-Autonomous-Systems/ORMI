{
    "name": "ormi",
    "version": "0.0.1",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*",
        "plugins/*"
    ],
    "scripts": {
        "build": "turbo build",
        "start": "cd apps/web && bun run start",
        "dev": "turbo dev",
        "lint": "turbo lint",
        "format": "prettier --write \"**/*.{ts,tsx,md}\"",
        "create": "bun scripts/create-package.js"
    },
    "devDependencies": {
        "@workspace/eslint-config": "workspace:*",
        "@workspace/typescript-config": "workspace:*",
        "prettier": "^3.5.1",
        "turbo": "^2.4.2",
        "typescript": "5.7.3"
    },
    "packageManager": "bun@1.2.17",
    "engines": {
        "node": ">=20"
    }
}
