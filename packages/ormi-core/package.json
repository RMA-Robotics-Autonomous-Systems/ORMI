{
  "name": "@workspace/ormi-core",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    },
    "./datasources": {
      "types": "./dist/datasources/index.d.ts",
      "import": "./dist/datasources/index.js"
    },
    "./widgets": {
      "types": "./dist/widgets/index.d.ts",
      "import": "./dist/widgets/index.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard/index.d.ts",
      "import": "./dist/dashboard/index.js"
    },
    "./templates": {
      "types": "./dist/templates/index.d.ts",
      "import": "./dist/templates/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js"
    },
    "./renderers": {
      "types": "./dist/renderers/index.d.ts",
      "import": "./dist/renderers/index.js"
    },
    "./transforms": {
      "types": "./dist/transforms/index.d.ts",
      "import": "./dist/transforms/index.js"
    },
    "./rc-dock-theme.css": "./src/dashboard/components/rc-dock/rc-dock-theme.css"
  },
  "scripts": {
    "build": "tsc && copyfiles -u 1 \"src/**/*.css\" dist && tsc-alias -p tsconfig.json",
    "dev": "concurrently \"tsc --watch\" \"copyfiles -u 1 -w src/**/*.css dist\" \"tsc-alias -p tsconfig.json --watch\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "^5.7.3",
    "copyfiles": "^2.4.1",
    "concurrently": "^8.2.2",
    "tsc-alias": "^1.8.10"
  },
  "dependencies": {
    "@jsonforms/core": "^3.6.0",
    "@jsonforms/material-renderers": "^3.6.0",
    "@types/react-grid-layout": "^1.3.5",
    "@workspace/ormi-jsonforms": "workspace:*",
    "@workspace/ormi-plugins": "workspace:*",
    "@workspace/ui": "workspace:*",
    "lucide-react": "^0.523.0",
    "rc-dock": "^4.0.0-alpha.2",
    "react-grid-layout": "^1.5.2",
    "sonner": "^2.0.5"
  }
}
