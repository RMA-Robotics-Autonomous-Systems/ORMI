{
	"name": "@workspace/ormi-core",
	"version": "0.0.0",
	"private": true,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./plugins": {
			"types": "./dist/plugins/index.d.ts",
			"import": "./dist/plugins/index.js"
		},
		"./datasources": {
			"types": "./dist/datasources/index.d.ts",
			"import": "./dist/datasources/index.js"
		},
		"./datasources/worker": {
			"types": "./dist/datasources/worker/index.d.ts",
			"import": "./dist/datasources/worker/index.js"
		},
		"./widgets": {
			"types": "./dist/widgets/index.d.ts",
			"import": "./dist/widgets/index.js"
		},
		"./dashboard": {
			"types": "./dist/dashboard/index.d.ts",
			"import": "./dist/dashboard/index.js"
		},
		"./templates": {
			"types": "./dist/templates/index.d.ts",
			"import": "./dist/templates/index.js"
		},
		"./types": {
			"types": "./dist/types/index.d.ts",
			"import": "./dist/types/index.js"
		},
		"./renderers": {
			"types": "./dist/renderers/index.d.ts",
			"import": "./dist/renderers/index.js"
		},
		"./transforms": {
			"types": "./dist/transforms/index.d.ts",
			"import": "./dist/transforms/index.js"
		},
		"./flex-layout-theme.css": "./src/dashboard/components/flex-layout/flex-layout-theme.css"
	},
	"scripts": {
		"build": "tsc && copyfiles -u 1 \"src/**/*.css\" dist && tsc-alias -p tsconfig.json",
		"dev": "concurrently \"tsc --watch\" \"copyfiles -u 1 -w src/**/*.css dist\" \"tsc-alias -p tsconfig.json --watch\"",
		"lint": "eslint .",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist build .turbo node_modules"
	},
	"devDependencies": {
		"@types/bun": "^1.3.8",
		"@types/json-schema": "^7.0.15",
		"@types/node": "^25.2.1",
		"@types/react": "^19.2.13",
		"@types/react-dom": "^19.2.3",
		"@workspace/eslint-config": "workspace:*",
		"@workspace/typescript-config": "workspace:*",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"typescript": "^5.9.3",
		"copyfiles": "^2.4.1",
		"concurrently": "^9.2.1",
		"tsc-alias": "^1.8.16"
	},
	"dependencies": {
		"@jsonforms/core": "^3.7.0",
		"@jsonforms/material-renderers": "^3.7.0",
		"@jsonforms/react": "^3.7.0",
		"@types/crypto-js": "^4.2.2",
		"@types/react-grid-layout": "^2.1.0",
		"@workspace/ormi-jsonforms": "workspace:*",
		"@workspace/ormi-plugins": "workspace:*",
		"@workspace/ui": "workspace:*",
		"crypto-js": "^4.2.0",
		"date-fns": "^4.1.0",
		"flexlayout-react": "^0.8.18",
		"jotai": "^2.17.1",
		"json-schema": "^0.4.0",
		"lucide-react": "^0.563.0",
		"react-grid-layout": "^2.2.2",
		"react-resizable": "^3.1.3",
		"sonner": "^2.0.7",
		"uuid": "^14.0.0"
	}
}
