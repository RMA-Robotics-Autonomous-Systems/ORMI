{
	"name": "ormi-c2-control",
	"version": "1.0.0",
	"description": "Integrate the RMA Multi-Agent Framework (C2 / mission-control): mission commands and CRUD as remote calls",
	"private": true,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"test": "bun test src",
		"test:watch": "bun test --watch",
		"clean": "rm -rf dist build .turbo node_modules"
	},
	"devDependencies": {
		"@types/bun": "^1.3.8",
		"@types/node": "^25.2.1",
		"@types/react": "^19.2.13",
		"@workspace/eslint-config": "workspace:*",
		"@workspace/typescript-config": "workspace:*",
		"react": "^19.2.4",
		"typescript": "^5.9.3"
	},
	"dependencies": {
		"@jsonforms/core": "^3.7.0",
		"@workspace/ormi-core": "workspace:*",
		"@workspace/ormi-plugins": "workspace:*",
		"@workspace/ui": "workspace:*",
		"@workspace/utils": "workspace:*"
	},
	"ormi_plugin": true
}
