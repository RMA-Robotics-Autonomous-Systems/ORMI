{
	"name": "ormi-map-servers",
	"version": "1.0.0",
	"description": "Map-server adapters (GeoServer, OGC WMS, TiTiler, XYZ) for the map-layer registry",
	"private": true,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc",
		"lint": "eslint .",
