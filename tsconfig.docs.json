{
	"extends": "@workspace/typescript-config/base.json",
	"compilerOptions": {
		"moduleResolution": "bundler",
		"module": "preserve",
		"skipLibCheck": true,
		"noImplicitAny": false,
		"strictNullChecks": false,
		"strictFunctionTypes": false,
		"strictBindCallApply": false,
		"strictPropertyInitialization": false,
		"noImplicitThis": false,
		"alwaysStrict": false
	},
	"include": [
		"packages/ormi-core/src/**/*",
		"packages/ormi-plugins/src/**/*",
		"packages/ormi-jsonforms/src/**/*",
		"packages/utils/src/**/*",
		"plugins/ormi-std-widgets/src/**/*",
		"plugins/ormi-foxglove/src/**/*",
		"plugins/ormi-tello/src/**/*",
		"plugins/ormi-rest-bags/src/**/*",
		"plugins/ormi-fligth-indicator/src/**/*",
		"plugins/ormi-rosbridge-suite/src/**/*",
		"plugins/ormi-randoms-datasources/src/**/*",
		"plugins/teodor-emi-extension/src/**/*"
	],
	"exclude": [
		"**/node_modules/**",
		"**/*.test.ts",
		"**/*.spec.ts",
		"apps/**",
		"packages/ui/**"
	]
}
