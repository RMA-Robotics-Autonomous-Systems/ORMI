{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"concurrency": "50",
	"globalEnv": ["NODE_ENV", "CI"],
	"globalPassThroughEnv": ["SKIP_ENV_VALIDATION"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".next/**", "!.next/cache/**", "dist/**"],
			"env": [
				"NEXTAUTH_URL",
				"NEXTAUTH_SECRET",
				"DATABASE_URL",
				"APP_URL",
				"NEXT_PUBLIC_ENABLE_OFFLINE_MODE"
			]
		},
		"lint": {
			"dependsOn": ["^lint"],
			"inputs": [
				"src/**/*.{ts,tsx,js,jsx}",
				"app/**/*.{ts,tsx,js,jsx}",
				"components/**/*.{ts,tsx,js,jsx}",
				"eslint.config.js",
				".eslintrc*"
			],
			"outputs": [],
			"cache": true
		},
		"db-generate": {
			"cache": false,
			"env": ["DATABASE_URL"]
		},
		"plugin-init": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"typecheck": {
			"dependsOn": ["^build", "plugin-init", "db-generate"],
			"outputs": []
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true,
			"env": [
				"NEXTAUTH_URL",
				"NEXTAUTH_SECRET",
				"DATABASE_URL",
				"APP_URL",
				"NEXT_PUBLIC_ENABLE_OFFLINE_MODE"
			]
		},
		"clean": {
			"cache": false
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": []
		}
	}
}
